{
  "name": "dsh-mattpocock-skills",
  "version": "0.1.0",
  "description": "Matt Pocock's skills for the DeepSeek Harness, shipped verbatim from https://github.com/mattpocock/skills",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "catalog.json",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
